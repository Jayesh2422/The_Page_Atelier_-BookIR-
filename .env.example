# MongoDB Atlas connection string (Database → Connect → Drivers). Server-side only.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=page-atelier"
# Database name inside the cluster.
MONGODB_DATABASE="page_atelier"
# Optional. Google Books API key (Google Cloud Console → APIs & Services → Credentials).
# Without a key, unauthenticated requests are attempted, which are heavily rate-limited.
GOOGLE_BOOKS_API_KEY=""
# Optional. "true" lets the book-details API fetch Google Books metadata for a book that has
# never been enriched (one cached request, 2.5 s timeout). Recommended; off when unset.
ENRICH_ON_VIEW="true"
